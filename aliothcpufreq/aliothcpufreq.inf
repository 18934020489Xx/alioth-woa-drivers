;/*++
 ;
 ; aliothcpufreq.inf - EPSS max-frequency driver for SM8250 (alioth)
 ; Root-enumerated kernel service; writes the max LUT row to
 ; EPSS PERF_STATE (0x185910320 / 0x185920320) at load time.
 ;*/

[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318}
Provider    = %V_Nova%
CatalogFile = aliothcpufreq.cat
DriverVer   = 10/28/2026,1.0.0.0
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 12

; --------------------------------------------------------------------
[SourceDisksNames]
1 = %DiskDescription%,,,

[SourceDisksFiles]
aliothcpufreq.sys = 1

; --------------------------------------------------------------------
[Manufacturer]
%V_Nova% = AliothCpuFreq, NTARM64

; Root-enumerated device so PnP can install/start the service cleanly.
[AliothCpuFreq.NTARM64]
%DeviceDesc% = AliothCpuFreq_Install, Root\ALIOTHCPUFREQ

; --------------------------------------------------------------------
[AliothCpuFreq_Install.NT]
CopyFiles = @aliothcpufreq.sys

[AliothCpuFreq_Install.NT.HW]
AddReg = AliothCpuFreq_HW_AddReg

[AliothCpuFreq_HW_AddReg]
HKR,,"UpperFilters",0x00010000,"aliothcpufreq"

[AliothCpuFreq_Install.NT.Services]
AddService = aliothcpufreq, 0x00000800, AliothCpuFreq_Service_Inst ; service with device

[AliothCpuFreq_Service_Inst]
DisplayName   = %SvcDesc%
ServiceType   = 1                ; SERVICE_KERNEL_DRIVER
StartType     = 3                ; demand (started when the root device enumerates)
ErrorControl  = 1
ServiceBinary = %12%\aliothcpufreq.sys
LoadOrderGroup = Extended Base

; --------------------------------------------------------------------
[Strings]
V_Nova          = "Nova"
DiskDescription = "aliothcpufreq installation disk"
DeviceDesc      = "SM8250 EPSS Max Frequency Driver"
SvcDesc         = "Alioth EPSS Max Frequency Driver"
