;/*++
 ;
 ; qcfakepep.inf - Stub PEP driver for alioth PEP0 (QCOM0519 / QCOM2517)
 ; Class: System devices. Binds the ACPI PEP0 node so downstream Qualcomm
 ; drivers (qcsmmu8280 etc.) can resolve {55beca03} / {a0e1dd36}.
 ;*/

[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318}
Provider    = %V_Nova%
CatalogFile = qcfakepep.cat
DriverVer   = 10/28/2026,1.0.0.0
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 12

; --------------------------------------------------------------------
[SourceDisksNames]
1 = %DiskDescription%,,,

[SourceDisksFiles]
qcfakepep.sys = 1

; --------------------------------------------------------------------
[Manufacturer]
%V_Nova% = QcFakePep, NTARM64

[QcFakePep.NTARM64]
%PEP0519.DeviceDesc% = QcFakePep_Install, ACPI\VEN_QCOM&DEV_0519
%PEP2517.DeviceDesc% = QcFakePep_Install, ACPI\VEN_QCOM&DEV_2517

; --------------------------------------------------------------------
[QcFakePep_Install.NT]
CopyFiles = @qcfakepep.sys

[QcFakePep_Install.NT.HW]
AddReg = QcFakePep_HW_AddReg

[QcFakePep_HW_AddReg]
; Nothing board-specific needed.

[QcFakePep_Install.NT.Services]
AddService = qcfakepep, 0x00000002, QcFakePep_Service_Inst ; function driver

[QcFakePep_Service_Inst]
DisplayName   = %SvcDesc%
ServiceType   = 1                ; SERVICE_KERNEL_DRIVER
StartType     = 3                ; SERVICE_DEMAND_START (PnP starts it on enumeration)
ErrorControl  = 1                ; normal
ServiceBinary = %12%\qcfakepep.sys
LoadOrderGroup = Extended Base

; --------------------------------------------------------------------
[Strings]
V_Nova             = "Nova"
DiskDescription    = "qcfakepep installation disk"
PEP0519.DeviceDesc = "Qualcomm PEP0 (Stub Power Engine) - QCOM0519"
PEP2517.DeviceDesc = "Qualcomm PEP0 (Stub Power Engine) - QCOM2517"
SvcDesc            = "Qualcomm Stub PEP Driver (qcfakepep)"
